#include <Wire.h>
#include <Servo.h>
#include <avr/pgmspace.h>

#define MPU_ADDR         0x68
#define REG_PWR_MGMT_1   0x6B
#define REG_GYRO_CONFIG  0x1B
#define REG_ACCEL_CONFIG 0x1C
#define REG_ACCEL_XOUT_H 0x3B

const uint8_t SERVO_X_PIN = 9;
const uint8_t SERVO_Y_PIN = 10;

const float SERVO_CENTER_DEG  = 85.0;
const float SERVO_MAX_DEFLECT = 30.0;   

const float GYRO_SCALE  = 131.0;    
const float ACCEL_SCALE = 16384.0;  
const float COMP_FILTER_ALPHA = 0.98;


float Kp_x = 0.85, Ki_x = 0.05, Kd_x = 0.13;
float Kp_y = 0.85, Ki_y = 0.05, Kd_y = 0.13;

const float INTEGRAL_CLAMP = 10.0; 


#define ENABLE_GAIN_SCHEDULING 1
const float THRUST_REFERENCE_N = 15.0; 
const float GAIN_SCALE_MIN = 0.5;
const float GAIN_SCALE_MAX = 1.8;

#if ENABLE_GAIN_SCHEDULING
const uint8_t THRUST_CURVE_LEN = 13;

const float thrustCurveT[THRUST_CURVE_LEN] PROGMEM = {
  0.00, 0.20, 0.28, 0.47, 0.75, 1.04, 1.34, 1.67, 1.96, 2.24, 2.53, 2.82, 3.05
};
const float thrustCurveN[THRUST_CURVE_LEN] PROGMEM = {
  11.7, 25.3, 22.0, 17.5, 15.7, 14.9, 14.7, 14.4, 14.2, 13.9, 13.4, 13.3, 13.2
};

float estimateThrustN(float tSinceLiftoff) {
  if (tSinceLiftoff <= pgm_read_float(&thrustCurveT[0])) {
    return pgm_read_float(&thrustCurveN[0]);
  }
  for (uint8_t i = 1; i < THRUST_CURVE_LEN; i++) {
    float t1 = pgm_read_float(&thrustCurveT[i]);
    if (tSinceLiftoff <= t1) {
      float t0 = pgm_read_float(&thrustCurveT[i - 1]);
      float n0 = pgm_read_float(&thrustCurveN[i - 1]);
      float n1 = pgm_read_float(&thrustCurveN[i]);
      float frac = (t1 > t0) ? (tSinceLiftoff - t0) / (t1 - t0) : 0.0;
      return n0 + frac * (n1 - n0);
    }
  }
  return 0.0; 
}
#endif

Servo servoX;
Servo servoY;

float gyroBiasX = 0, gyroBiasY = 0;
float angleX = 0, angleY = 0;

float integralX = 0, integralY = 0;

enum FlightState { PAD, BOOST, COAST };
FlightState flightState = PAD;

const float LIFTOFF_ACCEL_G    = 2.0;
const float BURNOUT_ACCEL_G    = 1.3;
const uint8_t LIFTOFF_DEBOUNCE = 3;
const uint8_t BURNOUT_DEBOUNCE = 5;
const float MAX_BURN_TIME_S    = 4.0; 

const int8_t SERVO_X_DIR = -1;   // -1 means reverse x
const int8_t SERVO_Y_DIR =  1;   // -1 means reverse y

uint8_t liftoffCounter = 0;
uint8_t burnoutCounter = 0;
unsigned long liftoffMillis = 0;

unsigned long lastLoopMicros = 0;

void mpuWriteRegister(uint8_t reg, uint8_t value) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.write(value);
  Wire.endTransmission();
}

void mpuReadRawData(int16_t &ax, int16_t &ay, int16_t &az,
                     int16_t &gx, int16_t &gy, int16_t &gz) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(REG_ACCEL_XOUT_H);
  Wire.endTransmission(false);
  Wire.requestFrom(MPU_ADDR, (uint8_t)14, (uint8_t)true);

  ax = (Wire.read() << 8) | Wire.read();
  ay = (Wire.read() << 8) | Wire.read();
  az = (Wire.read() << 8) | Wire.read();
  Wire.read(); Wire.read();
  gx = (Wire.read() << 8) | Wire.read();
  gy = (Wire.read() << 8) | Wire.read();
  gz = (Wire.read() << 8) | Wire.read();
}

void calibrateGyro(uint16_t samples = 500) {
  Serial.println(F("Calibrating gyro - keep rocket still and level..."));
  long sumX = 0, sumY = 0;
  int16_t ax, ay, az, gx, gy, gz;

  for (uint16_t i = 0; i < samples; i++) {
    mpuReadRawData(ax, ay, az, gx, gy, gz);
    sumX += gx;
    sumY += gy;
    delay(3);
  }

  gyroBiasX = (sumX / (float)samples) / GYRO_SCALE;
  gyroBiasY = (sumY / (float)samples) / GYRO_SCALE;

  Serial.print(F("Gyro bias X: "));
  Serial.print(gyroBiasX);
  Serial.print(F("  Y: "));
  Serial.println(gyroBiasY);
}

float computePID(float error, float &integral, float rate,
                  float Kp, float Ki, float Kd, float dt) {
  integral += error * dt;
  integral = constrain(integral, -INTEGRAL_CLAMP, INTEGRAL_CLAMP);
  return (Kp * error) + (Ki * integral) - (Kd * rate);
}

void writeServoClamped(Servo &servo, float correctionDeg) {
  correctionDeg = constrain(correctionDeg, -SERVO_MAX_DEFLECT, SERVO_MAX_DEFLECT);
  float commandDeg = SERVO_CENTER_DEG + correctionDeg;
  servo.write((int)round(commandDeg));
}

void updateFlightState(float accelMagG) {
  switch (flightState) {
    case PAD:
      if (accelMagG > LIFTOFF_ACCEL_G) {
        liftoffCounter++;
        if (liftoffCounter >= LIFTOFF_DEBOUNCE) {
          flightState = BOOST;
          liftoffMillis = millis();
          burnoutCounter = 0;
          Serial.println(F("Liftoff detected - boost control active."));
        }
      } else {
        liftoffCounter = 0;
      }
      break;

    case BOOST: {
      float tSinceLiftoff = (millis() - liftoffMillis) / 1000.0;
      if (accelMagG < BURNOUT_ACCEL_G) {
        burnoutCounter++;
      } else {
        burnoutCounter = 0;
      }
      if (burnoutCounter >= BURNOUT_DEBOUNCE || tSinceLiftoff > MAX_BURN_TIME_S) {
        flightState = COAST;
        Serial.println(F("Burnout - TVC disabled, centering."));
      }
      break;
    }

    case COAST:
    
      break;
  }
}

void setup() {
  Serial.begin(115200);
  Wire.begin();
  Wire.setClock(400000);

  mpuWriteRegister(REG_PWR_MGMT_1, 0x00);
  delay(100);

  mpuWriteRegister(REG_GYRO_CONFIG, 0x00);
  mpuWriteRegister(REG_ACCEL_CONFIG, 0x00);

  servoX.attach(SERVO_X_PIN);
  servoY.attach(SERVO_Y_PIN);
  writeServoClamped(servoX, 0);
  writeServoClamped(servoY, 0);
  delay(500);

  calibrateGyro();

  lastLoopMicros = micros();
  Serial.println(F("TVC controller ready."));
}

void loop() {
  unsigned long nowMicros = micros();
  float dt = (nowMicros - lastLoopMicros) / 1000000.0;
  if (dt <= 0) dt = 0.001;
  lastLoopMicros = nowMicros;

  int16_t axRaw, ayRaw, azRaw, gxRaw, gyRaw, gzRaw;
  mpuReadRawData(axRaw, ayRaw, azRaw, gxRaw, gyRaw, gzRaw);

  float ax = axRaw / ACCEL_SCALE;
  float ay = ayRaw / ACCEL_SCALE;
  float az = azRaw / ACCEL_SCALE;
  float accelMagG = sqrt(ax * ax + ay * ay + az * az);

  float gyroRateX = (gxRaw / GYRO_SCALE) - gyroBiasX;
  float gyroRateY = (gyRaw / GYRO_SCALE) - gyroBiasY;

  updateFlightState(accelMagG);

  bool trustAccel = (flightState != BOOST);

  if (trustAccel) {
    float accelAngleX = atan2(ay, sqrt(ax * ax + az * az)) * 180.0 / PI;
    float accelAngleY = atan2(-ax, sqrt(ay * ay + az * az)) * 180.0 / PI;
    angleX = COMP_FILTER_ALPHA * (angleX + gyroRateX * dt) + (1 - COMP_FILTER_ALPHA) * accelAngleX;
    angleY = COMP_FILTER_ALPHA * (angleY + gyroRateY * dt) + (1 - COMP_FILTER_ALPHA) * accelAngleY;
  } else {
    
    angleX += gyroRateX * dt;
    angleY += gyroRateY * dt;
  }

  if (flightState == COAST) {
    integralX = 0;
    integralY = 0;
    writeServoClamped(servoX, 0);
    writeServoClamped(servoY, 0);
  } else {
    float gainScale = 1.0;
#if ENABLE_GAIN_SCHEDULING
    if (flightState == BOOST) {
      float tSinceLiftoff = (millis() - liftoffMillis) / 1000.0;
      float thrustEstimate = estimateThrustN(tSinceLiftoff);
      if (thrustEstimate > 0.5) {
        gainScale = constrain(THRUST_REFERENCE_N / thrustEstimate, GAIN_SCALE_MIN, GAIN_SCALE_MAX);
      }
    }
#endif

    float errorX = 0.0 - angleX;
    float errorY = 0.0 - angleY;

    float correctionX = computePID(errorX, integralX, gyroRateX,
                                    Kp_x * gainScale, Ki_x, Kd_x * gainScale, dt);
    float correctionY = computePID(errorY, integralY, gyroRateY,
                                    Kp_y * gainScale, Ki_y, Kd_y * gainScale, dt);
                                    
    writeServoClamped(servoX, SERVO_X_DIR * correctionX);
    writeServoClamped(servoY, SERVO_Y_DIR * correctionY);
  }

  delay(7); 
}
